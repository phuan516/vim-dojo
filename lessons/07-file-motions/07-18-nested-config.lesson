          notify: [
            'payments@acme.dev',
            'security@acme.dev',
          ],
        },
        lastRotatedAt: '2026-06-01',
      },
      timeouts: { connect: 2000, read: 5000, total: 10000 },
      retries: {
        attempts: 3,
        backoff: {
          strategy: 'exponential',
          initialMs: 250,
          maxMs: 8000,
        },
        retryOn: [502, 503, 504],
      },
    },
    sandbox: {
      baseUrl: 'https://sandbox.acme-payments.com/v2',
      credentials: {
        keyId: process.env.ACME_SANDBOX_KEY_ID,
        secret: process.env.ACME_SANDBOX_SECRET,
        rotation: {
          enabled: false,
          everyDays: 0,
          notify: [],
