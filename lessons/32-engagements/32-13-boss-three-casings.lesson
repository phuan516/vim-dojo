export type Dispatch = {
  id: string;
  orderId: string;
  carrier: string;
  trackingRef: string;
  dispatchedAt: Date;
  status: DispatchStatus;
};

export type DispatchStatus = 'PENDING' | 'SENT' | 'DELIVERED';

@expected src/domain/shipping/shipping.entity.ts
export type Fulfilment = {
  id: string;
  orderId: string;
  carrier: string;
  trackingRef: string;
  fulfilmentedAt: Date;
  status: FulfilmentStatus;
};

export type FulfilmentStatus = 'PENDING' | 'SENT' | 'DELIVERED';

@start src/domain/shipping/shipping.repository.ts
import { injectable } from 'tsyringe';
import { Shipment as ShipmentRecord } from '@prisma/client';
import { BaseRepository } from '../../infrastructure/base.repository';
import { Dispatch } from './shipping.entity';

@injectable()
export class ShippingRepository extends BaseRepository<ShipmentRecord, Dispatch> {
  public toEntity(record: ShipmentRecord): Dispatch {
    return {
      id: record.id,
      orderId: record.orderId,
      carrier: record.carrier,
      trackingRef: record.trackingRef,
      dispatchedAt: record.dispatchedAt,
      status: record.status,
    };
  }
}

@expected src/domain/shipping/shipping.repository.ts
import { injectable } from 'tsyringe';
import { Shipment as ShipmentRecord } from '@prisma/client';
import { BaseRepository } from '../../infrastructure/base.repository';
import { Fulfilment } from './shipping.entity';

@injectable()
export class ShippingRepository extends BaseRepository<ShipmentRecord, Fulfilment> {
  public toEntity(record: ShipmentRecord): Fulfilment {
    return {
      id: record.id,
      orderId: record.orderId,
      carrier: record.carrier,
      trackingRef: record.trackingRef,
      fulfilmentedAt: record.fulfilmentedAt,
      status: record.status,
    };
  }
}

@start src/domain/shipping/shipping.provider.ts
import { injectable, inject } from 'tsyringe';
import { exception } from '../../configuration/errors';
import { ShippingRepository } from './shipping.repository';

@injectable()
export class ShippingProvider {
  constructor(
    @inject(ShippingRepository) protected shippingRepository: ShippingRepository,
  ) {}

  public async dispatch(orderId: string) {
    const dispatch = await this.shippingRepository.findOne({ where: { orderId } });

    if (!dispatch) {
      throw exception('DISPATCH_NOT_FOUND');
    }

    if (dispatch.dispatchedAt) {
      throw exception('DISPATCH_ALREADY_SENT');
    }

    return this.shippingRepository.update({
      where: { orderId },
      values: { dispatchedAt: new Date(), status: 'SENT' },
    });
  }
}

@expected src/domain/shipping/shipping.provider.ts
import { injectable, inject } from 'tsyringe';
import { exception } from '../../configuration/errors';
import { ShippingRepository } from './shipping.repository';

@injectable()
export class ShippingProvider {
  constructor(
    @inject(ShippingRepository) protected shippingRepository: ShippingRepository,
  ) {}

  public async fulfilment(orderId: string) {
    const fulfilment = await this.shippingRepository.findOne({ where: { orderId } });

    if (!fulfilment) {
      throw exception('FULFILMENT_NOT_FOUND');
    }

    if (fulfilment.fulfilmentedAt) {
      throw exception('FULFILMENT_ALREADY_SENT');
    }

    return this.shippingRepository.update({
      where: { orderId },
      values: { fulfilmentedAt: new Date(), status: 'SENT' },
    });
  }
}

@start src/domain/shipping/shipping.resolver.ts
import { injectable, inject } from 'tsyringe';
import { ShippingProvider } from './shipping.provider';

@injectable()
export class ShippingResolver {
  constructor(@inject(ShippingProvider) protected shippingProvider: ShippingProvider) {}

  public async dispatchOrder(_: unknown, args: { orderId: string }) {
    return this.shippingProvider.dispatch(args.orderId);
  }
}

