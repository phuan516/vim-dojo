#!/usr/bin/env bash
# vim-dojo — learn vim by doing real editing work, every day, for a year.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
command -v python3 >/dev/null || { echo "vim-dojo needs python3"; exit 1; }
command -v vim     >/dev/null || { echo "vim-dojo needs vim";     exit 1; }
cd "$ROOT" && exec python3 -m engine.dojo "$@"
