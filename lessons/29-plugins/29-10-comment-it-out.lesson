vscode: Ctrl-/, the one keybinding everybody keeps
open: order.provider.ts
vimrc: set packpath^=. | packloadall!

@brief
Second plugin, shipped the same way as the first:

    pack/dojo/start/commentary/plugin/commentary.vim

Fifty lines of code. Nothing downloaded. It gives you `gc`, a verb that toggles
comments, and `gcc`, the line-at-a-time form — the same doubling
convention as `dd` and `yy`.

Two edits in `cancel`:

  1. The `console.log` was left behind by whoever last debugged this.
     Comment it out rather than deleting it; the ticket says it is
     wanted again next sprint.
  2. The shipped-order guard above it was commented out during an
     incident and never restored. Bring it back.

One verb, both directions. `gc` toggles: if every line in the range is
commented it uncomments them, otherwise it comments them.

@keys
| `gcc` | toggle the comment on this line |
| `gc{motion}` | toggle every line the motion covers |
| `gc2j` | this line and the two below |
| `gcap` | the whole paragraph |
| `{Visual}gc` | toggle the selection |

@hints
One of the two is a single line, so it wants the doubled form. The other
is three lines, so it wants `gc` with a motion that reaches them.
--
`gcc` on the `console.log`. For the guard, put the cursor on its first
line and give `gc` a motion that covers three lines.
--
`/console` `Enter` `gcc`, then `/if (order` `Enter` `gc2j`.

@solution
    /console<Enter>  gcc
    /if (order<Enter>  gc2j
    :wq<Enter>

Thirty-one keystrokes, and the second half is the part that pays.

`gc` is an operator. That sentence is the whole lesson. It means every
motion and every text object you own already works with it, on day one,
without the plugin knowing anything about them: `gcap` comments a
paragraph, `gci{` comments the inside of a block, `gc}` comments to the
end of the paragraph, `gc/TODO` `Enter` comments everything up to the
next TODO. VS Code's Ctrl-/ has one range — the selection — and you have
to make the selection first.

Toggling is the other half. There is no "uncomment" key, because the
plugin looks at the range and decides: all commented means uncomment,
anything else means comment. So `gcc` twice is a no-op, and the same
keys undo an accidental comment without you switching command.

The real one is tpope's vim-commentary, and `gc` means exactly this there
too. It is eighty lines. There is no version of this where a plugin that
does one small thing needs to be big.

@start pack/dojo/start/commentary/plugin/commentary.vim
" dojo-commentary.vim - a small, honest commenting plugin.
" Shipped inside this lesson. You did not install it; the dojo did.
"
"   gcc          toggle the comment on this line
"   gc{motion}   toggle the comment on every line the motion covers
"   {Visual}gc   toggle the comment on the selection
"
" It never guesses the comment syntax. It reads 'commentstring', which the
" filetype plugin already set: // %s for typescript, -- %s for sql,
" <!-- %s --> for markdown, # %s for yaml.

if exists('g:loaded_dojo_commentary')
  finish
endif
let g:loaded_dojo_commentary = 1

function! s:parts() abort
  let cms = &commentstring =~# '%s' ? &commentstring : '# %s'
  let at = stridx(cms, '%s')
  return [substitute(strpart(cms, 0, at), '\s*$', '', ''),
        \ substitute(strpart(cms, at + 2), '^\s*', '', '')]
endfunction

function! s:rx(text) abort
  return escape(a:text, '\.*$^~[]/')
endfunction

function! s:toggle(first, last) abort
  let [open, close] = s:parts()
  let head = '^\(\s*\)' . s:rx(open) . ' \?'
  let tail = ' \?' . s:rx(close) . '\s*$'
  let lines = getline(a:first, a:last)
  let code = filter(copy(lines), 'v:val =~# "\\S"')
  if empty(code)
    return
  endif
  " Uncomment only when every non-blank line is already commented.
  " Otherwise a half-commented block would flip into a mess.
  let strip = 1
  let indent = 999
  for line in code
    let strip = strip && line =~# head
    let indent = min([indent, match(line, '\S')])
  endfor
  let n = a:first
  for line in lines
    if line =~# '\S'
      if strip
        let out = substitute(line, head, '\1', '')
        let out = close ==# '' ? out : substitute(out, tail, '', '')
      else
        let body = open . ' ' . strpart(line, indent)
        let out = strpart(line, 0, indent) . (close ==# '' ? body : body . ' ' . close)
      endif
      call setline(n, out)
    endif
    let n += 1
  endfor
endfunction

function! s:opfunc(type) abort
  call s:toggle(line("'["), line("']"))
endfunction

nnoremap <silent> gcc :<C-u>call <SID>toggle(line('.'), line('.'))<CR>
nnoremap <silent> gc :<C-u>set operatorfunc=<SID>opfunc<CR>g@
xnoremap <silent> gc :<C-u>call <SID>toggle(line("'<"), line("'>"))<CR>

@start order.provider.ts
export class OrderProvider {
  public async cancel(id: string) {
    const order = await this.orderRepository.findOne({ where: { id } });

    // if (order.status === 'SHIPPED') {
    //   throw exception('ORDER_ALREADY_SHIPPED');
    // }

    console.log('cancel', id, order.status);

    await this.paymentService.refund(order.id);
  }
}

@expected order.provider.ts
export class OrderProvider {
  public async cancel(id: string) {
    const order = await this.orderRepository.findOne({ where: { id } });

    if (order.status === 'SHIPPED') {
      throw exception('ORDER_ALREADY_SHIPPED');
    }

    // console.log('cancel', id, order.status);

    await this.paymentService.refund(order.id);
  }
}
