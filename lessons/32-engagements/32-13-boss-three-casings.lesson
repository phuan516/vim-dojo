import { injectable, inject } from 'tsyringe';
import { ShippingProvider } from '../domain/shipping/shipping.provider';

@injectable()
export class ShippingConsumer {
  public readonly routingKey = 'order.dispatched';

  constructor(@inject(ShippingProvider) protected shippingProvider: ShippingProvider) {}

  public async consume(message: { orderId: string }) {
    return this.shippingProvider.dispatch(message.orderId);
  }
}

