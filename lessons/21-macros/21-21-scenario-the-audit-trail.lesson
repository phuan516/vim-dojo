];

@start order.repository.ts
import { PrismaClient, Order as OrderRecord } from '@prisma/client';

export class OrderRepository {
  constructor(protected prisma: PrismaClient) {}

  public async findOne(args: { where: { id: string } }) {
    return this.prisma.order.findFirst(args);
  }

  public async update(args: { where: { id: string }; values: Partial<OrderRecord> }) {
    return this.prisma.order.update({ where: args.where, data: args.values });
  }
}

@start audit.service.ts
export class AuditService {
  public async record(entityId: string) {
    await this.http.post('/audit', { entityId, at: new Date().toISOString() });
  }
}
