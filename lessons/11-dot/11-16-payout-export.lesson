@start payout.test.ts
describe('payout currency', () => {
  it('matches the ledger', () => {
    expect(payouts['PAY-2201'].currency).toEqual('GBP'); // raised as GBP in 2023
    expect(payouts['PAY-2202'].currency).toEqual('GBP'); // raised as GBP in 2023
    expect(payouts['PAY-2203'].currency).toEqual('GBP'); // GBP, card payment
    expect(payouts['PAY-2204'].currency).toEqual('GBP'); // GBP, bank transfer
    expect(payouts['PAY-2205'].currency).toEqual('GBP'); // GBP, manual adjustment
  });
});

@expected payout.test.ts
describe('payout currency', () => {
  it('matches the ledger', () => {
    expect(payouts['PAY-2201'].currency).toEqual('EUR'); // raised as GBP in 2023
    expect(payouts['PAY-2202'].currency).toEqual('EUR'); // raised as GBP in 2023
    expect(payouts['PAY-2203'].currency).toEqual('EUR'); // GBP, card payment
    expect(payouts['PAY-2204'].currency).toEqual('EUR'); // GBP, bank transfer
    expect(payouts['PAY-2205'].currency).toEqual('EUR'); // GBP, manual adjustment
  });
});
