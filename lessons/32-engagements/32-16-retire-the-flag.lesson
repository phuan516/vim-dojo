export type Flags = {
  giftReceipts: boolean;
  saveCardOnFile: boolean;
};

@start src/domain/order/checkout.resolver.ts
import { injectable, inject } from 'tsyringe';
import { CheckoutProvider } from './checkout.provider';

@injectable()
export class CheckoutResolver {
  constructor(@inject(CheckoutProvider) protected checkoutProvider: CheckoutProvider) {}

  public async checkoutOptions() {
    return {
      expressCheckout: this.flags.expressCheckout,
      giftReceipts: this.flags.giftReceipts,
      saveCardOnFile: this.flags.saveCardOnFile,
    };
  }
}

@expected src/domain/order/checkout.resolver.ts
import { injectable, inject } from 'tsyringe';
import { CheckoutProvider } from './checkout.provider';

@injectable()
export class CheckoutResolver {
  constructor(@inject(CheckoutProvider) protected checkoutProvider: CheckoutProvider) {}

  public async checkoutOptions() {
    return {
      giftReceipts: this.flags.giftReceipts,
      saveCardOnFile: this.flags.saveCardOnFile,
    };
  }
}

