@start refund.constants.ts
export type RefundStatus = 'pending' | 'approved' | 'rejected' | 'settled';

export const INITIAL_STATUS: RefundStatus = 'pending';
export const TERMINAL_STATUSES: RefundStatus[] = ['rejected', 'settled'];
export const REVIEW_REQUIRED: RefundStatus[] = ['pending'];

export const STATUS_MESSAGES: Record<RefundStatus, string> = {
  pending: 'Your refund is pending review',
  approved: 'Your refund has been approved',
  rejected: 'We could not approve this refund',
  settled: 'Your refund has been settled',
};

@expected refund.constants.ts
export type RefundStatus = 'PENDING' | 'APPROVED' | 'REJECTED' | 'SETTLED';

export const INITIAL_STATUS: RefundStatus = 'PENDING';
export const TERMINAL_STATUSES: RefundStatus[] = ['REJECTED', 'SETTLED'];
export const REVIEW_REQUIRED: RefundStatus[] = ['PENDING'];

export const STATUS_MESSAGES: Record<RefundStatus, string> = {
  PENDING: 'Your refund is pending review',
  APPROVED: 'Your refund has been approved',
  REJECTED: 'We could not approve this refund',
  SETTLED: 'Your refund has been settled',
};

@start seed.sql
-- Production seed. Loaded into every environment, including test.
INSERT INTO orders (id, customer_id, status, total) VALUES
  ('ord_9101', 'cus_9101', 'PAID', 1999),
