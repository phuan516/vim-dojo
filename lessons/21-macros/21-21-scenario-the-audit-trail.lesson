  public async issue(id: string) {
    return this.refundRepository.update({
      where: { id },
      values: { status: 'ISSUED' },
    });
  }

  public async reverse(id: string) {
    return this.refundRepository.update({
      where: { id },
      values: { status: 'REVERSED' },
    });
  }
}

@expected refund.provider.ts
import { RefundRepository } from './refund.repository';
import { AuditService } from '../../infrastructure/services/audit.service';

export class RefundProvider {
  constructor(
    protected refundRepository: RefundRepository,
    protected auditLog: AuditService,
  ) {}

  public async issue(id: string) {
    await this.auditLog.record(id);
    return this.refundRepository.update({
      where: { id },
      values: { status: 'ISSUED' },
    });
  }

  public async reverse(id: string) {
    await this.auditLog.record(id);
    return this.refundRepository.update({
      where: { id },
      values: { status: 'REVERSED' },
    });
  }
}

@start shipment.provider.ts
import { ShipmentRepository } from './shipment.repository';
import { AuditService } from '../../infrastructure/services/audit.service';

export class ShipmentProvider {
  constructor(
    protected shipmentRepository: ShipmentRepository,
    protected auditLog: AuditService,
  ) {}

  public async dispatch(id: string) {
    const shipment = await this.shipmentRepository.findOne({ where: { id } });

    await this.shipmentRepository.update({
      where: { id },
      values: { status: 'DISPATCHED', dispatchedAt: new Date() },
    });

    return shipment;
  }

  public async deliver(id: string) {
    return this.shipmentRepository.update({
      where: { id },
      values: { status: 'DELIVERED', deliveredAt: new Date() },
    });
  }
}

@expected shipment.provider.ts
import { ShipmentRepository } from './shipment.repository';
import { AuditService } from '../../infrastructure/services/audit.service';

export class ShipmentProvider {
  constructor(
    protected shipmentRepository: ShipmentRepository,
    protected auditLog: AuditService,
  ) {}

  public async dispatch(id: string) {
    const shipment = await this.shipmentRepository.findOne({ where: { id } });

    await this.auditLog.record(id);
    await this.shipmentRepository.update({
      where: { id },
      values: { status: 'DISPATCHED', dispatchedAt: new Date() },
    });

    return shipment;
  }

  public async deliver(id: string) {
    await this.auditLog.record(id);
    return this.shipmentRepository.update({
      where: { id },
      values: { status: 'DELIVERED', deliveredAt: new Date() },
    });
  }
}

