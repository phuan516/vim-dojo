@start src/infrastructure/services/payment.service.ts
import { injectable } from 'tsyringe';
import { exception } from '../../configuration/errors';

@injectable()
export class PaymentService {
  public async refund(orderId: string, amount: number) {
    const response = await this.http.post(`/refunds`, { orderId, amount });

    if (response.status !== 200) {
      throw exception('REFUND_FAILED');
    }

    return response.data.refund.amount;
  }
}

@expected src/infrastructure/services/payment.service.ts
import { injectable } from 'tsyringe';
import { exception } from '../../configuration/errors';

@injectable()
export class PaymentService {
  public async refund(orderId: string, amount: number) {
    const response = await this.http.post(`/refunds`, { orderId, amount });

    if (response.status !== 200) {
      throw exception('REFUND_FAILED');
    }

    if (!response.data.refund) {
      throw exception('REFUND_ORDER_UNKNOWN');
    }

    return response.data.refund.amount;
  }
}

@start src/consumers/refund.consumer.ts
import { injectable, inject } from 'tsyringe';
import { PaymentService } from '../infrastructure/services/payment.service';

@injectable()
export class RefundConsumer {
  constructor(@inject(PaymentService) protected paymentService: PaymentService) {}

  public async consume(message: { orderId: string; amount: number; attempt: number }) {
    try {
      return await this.paymentService.refund(message.orderId, message.amount);
    } catch (error) {
      if (message.attempt < 25) {
        return this.requeue(message);
      }

      throw error;
    }
  }

  public async requeue(message: { orderId: string; amount: number; attempt: number }) {
    return this.queue.publish('refund', { ...message, attempt: message.attempt + 1 });
  }
}

@expected src/consumers/refund.consumer.ts
import { injectable, inject } from 'tsyringe';
import { PaymentService } from '../infrastructure/services/payment.service';

@injectable()
export class RefundConsumer {
  constructor(@inject(PaymentService) protected paymentService: PaymentService) {}

  public async consume(message: { orderId: string; amount: number; attempt: number }) {
    try {
      return await this.paymentService.refund(message.orderId, message.amount);
    } catch (error) {
      if (error.code !== 'REFUND_ORDER_UNKNOWN' && message.attempt < 25) {
        return this.requeue(message);
      }

      throw error;
    }
  }

  public async requeue(message: { orderId: string; amount: number; attempt: number }) {
    return this.queue.publish('refund', { ...message, attempt: message.attempt + 1 });
  }
}

