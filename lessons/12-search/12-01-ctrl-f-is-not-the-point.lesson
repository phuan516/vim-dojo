    });

    if (!customer) {
      throw exception('CUSTOMER_NOT_FOUND');
    }

    const order = await this.orderRepository.create({
      values: {
        customerId: customer.id,
        total: args.total,
        status: 'PENDING',
      },
    });

    await this.emailService.sendOrderConfirmation(customer.email, order.id);

    return order;
  }

  public async addLine(args: { id: string; sku: string; price: number }) {
    const order = await this.findOne({ id: args.id });

    if (order.status !== 'PENDING') {
      throw exception('ORDER_ALREADY_SUBMITTED');
    }

    return this.orderRepository.update({
      where: { id: order.id },
      values: { total: order.total + args.price },
    });
  }

  public async applyDiscount(args: { id: string; percent: number }) {
    const order = await this.findOne({ id: args.id });

    if (args.percent < 0 || args.percent > 100) {
      throw exception('DISCOUNT_OUT_OF_RANGE');
    }

    const discounted = Math.round(order.total * (1 - args.percent / 100));

    return this.orderRepository.update({
      where: { id: order.id },
      values: { total: discounted },
    });
  }

  public async submit(args: { id: string }) {
    const order = await this.findOne({ id: args.id });

    if (order.total <= 0) {
      throw exception('ORDER_EMPTY');
    }

    await this.paymentService.charge(order.id, order.total);

    return this.orderRepository.update({
      where: { id: order.id },
      values: { status: 'SUBMITTED' },
    });
  }

  public async ship(args: { id: string; carrier: string }) {
    const order = await this.findOne({ id: args.id });

    if (order.status !== 'SUBMITTED') {
      throw exception('ORDER_NOT_SUBMITTED');
    }

    return this.orderRepository.update({
      where: { id: order.id },
      values: { status: 'SHIPPED', carrier: args.carrier },
    });
  }

  public async cancel(args: { id: string }) {
    const order = await this.orderRepository.findOne({ where: { id: args.id } });

    if (!order) {
      throw exception('ORDER_NOT_FOUND');
    }

    await this.paymentService.refund(order.id);

    return this.orderRepository.update({
      where: { id: order.id },
      values: { status: 'CANCELLED' },
    });
  }
}
