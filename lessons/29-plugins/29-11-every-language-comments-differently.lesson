{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strictNullChecks": true,
    "outDir": "dist"
  }
}

@expected tsconfig.json
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    // "strictNullChecks": true,
    "outDir": "dist"
  }
}
