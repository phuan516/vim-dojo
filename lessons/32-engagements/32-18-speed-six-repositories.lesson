open: src/domain/order/order.repository.ts src/domain/customer/customer.repository.ts src/domain/billing/invoice.repository.ts src/domain/shipping/shipment.repository.ts src/domain/catalogue/product.repository.ts src/domain/address/address.repository.ts docs/soft-delete.md
