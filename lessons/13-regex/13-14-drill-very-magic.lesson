    "amqplib": "^0.10.4",
    "express": "~4.19.2",
    "graphql": "^16.9.0",
    "reflect-metadata": "^0.2.2",
    "stripe": "14.25.0",
    "tsyringe": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "typescript": "~5.5.4",
    "vitest": "latest"
  }
}

