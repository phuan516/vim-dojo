@start src/domain/customer.entity.ts
export type Customer = {
  id: string;
  email: string;
};

@start src/domain/customer.provider.ts
export class CustomerProvider {
  public async findOne(id: string) {
    return this.customerRepository.findOne({ where: { id } });
  }
}

@start src/domain/order.entity.ts
export type Order = {
  id: string;
  customerId: string;
  total: number;
};

@start src/domain/order.provider.ts
export class OrderProvider {
  public async cancel(id: string) {
    return this.orderRepository.update({ where: { id }, values: { status: 'CANCELLED' } });
  }
}

@start src/domain/order.repository.ts
export class OrderRepository extends BaseRepository<Order> {
  protected model = 'order';
}
