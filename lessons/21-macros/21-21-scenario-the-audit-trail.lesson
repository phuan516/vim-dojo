  { orderId: 'ord_101', action: 'cancel' },
  { orderId: 'ord_102', action: 'markShipped' },
  { orderId: 'ord_103', action: 'cancel' },
  { orderId: 'ord_104', action: 'issue' },
  { orderId: 'ord_105', action: 'reverse' },
