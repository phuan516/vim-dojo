@start src/domain/order/order.provider.ts
export class OrderProvider {
  public async list(customerId: string) {
    return this.orderRepository.findMany({ where: { customerId } });
  }
}

@start src/domain/order/order.repository.ts
export class OrderRepository {
  public async findMany(args: FindManyArgs) {
    return this.prisma.order.findMany(args);
  }
}

@start src/infrastructure/services/payment.service.ts
export class PaymentService {
  public async capture(orderId: string) {
    return this.client.post('/captures', { orderId });
  }
}

