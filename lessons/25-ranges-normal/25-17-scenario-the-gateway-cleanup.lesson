@start migrations.sql
ALTER TABLE payments DROP COLUMN legacy_reference
ALTER TABLE payments DROP COLUMN legacy_gateway_id
DROP INDEX payments_legacy_reference_idx
DELETE FROM gateways WHERE name = 'legacy'
UPDATE orders SET gateway = 'payment' WHERE gateway = 'legacy'
ALTER TABLE refunds ALTER COLUMN gateway SET DEFAULT 'payment'

@expected migrations.sql
