@start payment.worker.ts
import { inject, injectable } from 'tsyringe';
import { logger } from '../configuration/logger';
import { exception } from '../configuration/errors';
import { PaymentService } from '../infrastructure/services/payment.service';
import { RetryProvider } from '../domain/retry/retry.provider';

type CaptureMessage = {
  orderId: string;
  amount: number;
  attempt: number;
};

@injectable()
export class PaymentWorker {
  constructor(
    @inject(PaymentService) protected paymentService: PaymentService,
    @inject(RetryProvider) protected retryProvider: RetryProvider,
  ) {}

  public async handle(message: CaptureMessage) {
    console.log('handle', message);
    logger.info('capture received', { orderId: message.orderId, attempt: message.attempt });

    if (message.attempt > 3) {
      console.log('giving up', message.orderId);
      logger.warn('capture abandoned', { orderId: message.orderId });
      throw exception('CAPTURE_ABANDONED');
    }

    try {
      console.log('calling gateway', message.orderId);
      const result = await this.paymentService.capture(message.orderId, message.amount);
      console.log('gateway result', result);

      return result;
    } catch (error) {
      console.log('gateway failed', error);
      logger.error('capture failed', { orderId: message.orderId, error });
      console.log('scheduling retry', message.attempt + 1);

      return this.retryProvider.schedule({ ...message, attempt: message.attempt + 1 });
    }
  }
}

@expected payment.worker.ts
import { inject, injectable } from 'tsyringe';
import { logger } from '../configuration/logger';
import { exception } from '../configuration/errors';
import { PaymentService } from '../infrastructure/services/payment.service';
import { RetryProvider } from '../domain/retry/retry.provider';

type CaptureMessage = {
  orderId: string;
  amount: number;
  attempt: number;
};

@injectable()
export class PaymentWorker {
  constructor(
    @inject(PaymentService) protected paymentService: PaymentService,
    @inject(RetryProvider) protected retryProvider: RetryProvider,
  ) {}

  public async handle(message: CaptureMessage) {
    logger.info('capture received', { orderId: message.orderId, attempt: message.attempt });

    if (message.attempt > 3) {
      logger.warn('capture abandoned', { orderId: message.orderId });
      throw exception('CAPTURE_ABANDONED');
    }

    try {
      const result = await this.paymentService.capture(message.orderId, message.amount);

      return result;
    } catch (error) {
      logger.error('capture failed', { orderId: message.orderId, error });

      return this.retryProvider.schedule({ ...message, attempt: message.attempt + 1 });
    }
  }
}

@start registry.ts
import { container } from 'tsyringe';
import { OrderRepository } from '../domain/order/order.repository';
import { OrderProvider } from '../domain/order/order.provider';
import { PaymentService } from '../infrastructure/services/payment.service';
import { PaymentWorker } from '../workers/payment.worker';
container.register('OrderRepository', { useClass: OrderRepository });
container.register('OrderProvider', { useClass: OrderProvider });
container.register('PaymentService', { useClass: PaymentService });
import { RetryProvider } from '../domain/retry/retry.provider';
container.register('RetryProvider', { useClass: RetryProvider });
import { RetryConsumer } from '../domain/retry/retry.consumer';
container.register('RetryConsumer', { useClass: RetryConsumer });
container.register('PaymentWorker', { useClass: PaymentWorker });

@expected registry.ts
import { container } from 'tsyringe';
import { OrderRepository } from '../domain/order/order.repository';
import { OrderProvider } from '../domain/order/order.provider';
import { PaymentService } from '../infrastructure/services/payment.service';
import { PaymentWorker } from '../workers/payment.worker';
import { RetryProvider } from '../domain/retry/retry.provider';
import { RetryConsumer } from '../domain/retry/retry.consumer';
container.register('OrderRepository', { useClass: OrderRepository });
container.register('OrderProvider', { useClass: OrderProvider });
container.register('PaymentService', { useClass: PaymentService });
container.register('RetryProvider', { useClass: RetryProvider });
container.register('RetryConsumer', { useClass: RetryConsumer });
container.register('PaymentWorker', { useClass: PaymentWorker });

