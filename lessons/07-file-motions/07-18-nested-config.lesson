      },
      timeouts: { connect: 5000, read: 15000 },
      retries: {
        attempts: 1,
        backoff: {
          strategy: 'fixed',
          initialMs: 1000,
          maxMs: 1000,
        },
        retryOn: [503],
      },
    },
  },
  webhooks: {
    endpoint: '/webhooks/acme',
    events: [
      'refund.created',
      'refund.settled',
