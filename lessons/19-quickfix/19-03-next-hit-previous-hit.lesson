    reveal(orderRepository).findOne.mockResolvedValue(order);
    reveal(paymentService).sendRefund.mockResolvedValue(undefined);

    await provider.cancel(order.id);

    expect(paymentService.sendRefund).toHaveBeenCalledWith(order.id);
  });

  it('refuses to cancel a shipped order', async () => {
    const order = orderFactory({ status: 'SHIPPED' });
    reveal(orderRepository).findOne.mockResolvedValue(order);

    await expect(provider.cancel(order.id)).rejects.toThrow('ORDER_ALREADY_SHIPPED');
    expect(paymentService.sendRefund).not.toHaveBeenCalled();
  });

  it('rejects an unknown order', async () => {
    reveal(orderRepository).findOne.mockResolvedValue(undefined);

    await expect(provider.cancel('ord_404')).rejects.toThrow('ORDER_NOT_FOUND');
  });
});

@start src/domain/order/order.repository.ts
import { injectable } from 'tsyringe';
import { Order as OrderRecord } from '@prisma/client';
import { BaseRepository } from '../../infrastructure/base.repository';
import { Order } from './order.entity';

@injectable()
export class OrderRepository extends BaseRepository<OrderRecord, Order> {
  public async findByCustomer(args: { customerId: string }) {
    const records = await this.prisma.order.findMany({
      where: { customerId: args.customerId, deleted: null },
    });

    return records.map((record) => this.toEntity(record));
  }

  public toEntity(record: OrderRecord): Order {
    return {
      id: record.id,
      customerId: record.customerId,
      status: record.status,
      total: record.total,
      placedAt: record.placedAt,
    };
  }
}

@start src/domain/order/order.resolver.ts
import { injectable, inject } from 'tsyringe';
import { OrderProvider } from './order.provider';

@injectable()
export class OrderResolver {
  constructor(@inject(OrderProvider) protected orderProvider: OrderProvider) {}

  public async order(_: unknown, args: { id: string }) {
    return this.orderProvider.findOne(args.id);
  }

  public async cancelOrder(_: unknown, args: { id: string }) {
    return this.orderProvider.cancel(args.id);
  }
}

@start src/domain/payment/payment.provider.ts
import { injectable, inject } from 'tsyringe';
import { exception } from '../../configuration/errors';
import { PaymentRepository } from './payment.repository';
import { PaymentProducer } from './payment.producer';
import { PaymentService } from '../../infrastructure/services/payment.service';

@injectable()
export class PaymentProvider {
  constructor(
    @inject(PaymentRepository) protected paymentRepository: PaymentRepository,
    @inject(PaymentProducer) protected paymentProducer: PaymentProducer,
    @inject(PaymentService) protected paymentService: PaymentService,
  ) {}

  public async reverse(id: string) {
    const payment = await this.paymentRepository.findOne({ where: { id } });

    if (!payment) {
      throw exception('NOT_FOUND');
    }

    const receipt = await this.paymentService.sendRefund(payment.orderId);

    await this.paymentProducer.refundIssued({ paymentId: id, receipt });

    return receipt;
  }
}

@expected src/domain/payment/payment.provider.ts
import { injectable, inject } from 'tsyringe';
import { exception } from '../../configuration/errors';
import { PaymentRepository } from './payment.repository';
import { PaymentProducer } from './payment.producer';
import { PaymentService } from '../../infrastructure/services/payment.service';

@injectable()
export class PaymentProvider {
  constructor(
    @inject(PaymentRepository) protected paymentRepository: PaymentRepository,
    @inject(PaymentProducer) protected paymentProducer: PaymentProducer,
    @inject(PaymentService) protected paymentService: PaymentService,
  ) {}

  public async reverse(id: string) {
    const payment = await this.paymentRepository.findOne({ where: { id } });

    if (!payment) {
      throw exception('PAYMENT_NOT_FOUND');
    }

    const receipt = await this.paymentService.sendRefund(payment.orderId);

    await this.paymentProducer.refundIssued({ paymentId: id, receipt });

    return receipt;
  }
}

@start src/domain/payment/payment.producer.ts
import { injectable, inject } from 'tsyringe';
import { Channel } from '../../infrastructure/rabbit/channel';

type RefundIssuedEvent = {
  paymentId: string;
  receipt: string;
};

@injectable()
export class PaymentProducer {
  constructor(@inject(Channel) protected channel: Channel) {}

  public async refundIssued(event: RefundIssuedEvent) {
    await this.channel.publish('payments', 'payment.sendRefund', event);
  }
}

@start src/infrastructure/services/payment.service.ts
import { injectable, inject } from 'tsyringe';
import { exception } from '../../configuration/errors';
import { HttpClient } from '../http/http.client';

@injectable()
export class PaymentService {
  constructor(@inject(HttpClient) protected http: HttpClient) {}

  public async sendRefund(orderId: string) {
    const response = await this.http.post('/sendRefund', { orderId });

    if (response.status !== 200) {
      throw exception('REFUND_FAILED');
    }

    return response.data;
  }
}

