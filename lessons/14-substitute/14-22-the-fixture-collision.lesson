  pending: { id: 'rfd_0301', orderId: 'ord_10101', customerId: 'cus_9101', amount: 1999 },
  approved: { id: 'rfd_0302', orderId: 'ord_10104', customerId: 'cus_9104', amount: 1999 },
  rejected: { id: 'rfd_0303', orderId: 'ord_10112', customerId: 'cus_9112', amount: 4500 },
  settled: { id: 'rfd_0304', orderId: 'ord_10118', customerId: 'cus_9118', amount: 750 },
};

