import { injectable } from 'tsyringe';

@injectable()
export class AuditService {
  public async record(event: string, subjectId: string) {
    return this.http.post(`/audit`, { event, subjectId });
  }
}

@start src/infrastructure/services/metrics.service.ts
import { injectable } from 'tsyringe';

@injectable()
export class MetricsService {
  public increment(metric: string) {
    return this.statsd.increment(metric);
  }
}
