import { injectable, inject } from 'tsyringe';
import { formatAmount, formatMoney } from '../../support/format';
import { BillingService } from '../../infrastructure/services/billing.service';

@injectable()
export class InvoiceProvider {
  constructor(@inject(BillingService) protected billingService: BillingService) {}

  public async render(invoiceId: string) {
    const invoice = await this.billingService.findOne(invoiceId);

    return {
      total: formatMoney(invoice.total),
      vat: formatMoney(invoice.vat),
    };
  }
}

@expected src/domain/billing/invoice.provider.ts
import { injectable, inject } from 'tsyringe';
import { formatAmount, formatMoney } from '../../support/format';
import { BillingService } from '../../infrastructure/services/billing.service';

@injectable()
export class InvoiceProvider {
  constructor(@inject(BillingService) protected billingService: BillingService) {}

  public async render(invoiceId: string) {
    const invoice = await this.billingService.findOne(invoiceId);

    return {
      total: formatAmount(invoice.total),
      vat: formatAmount(invoice.vat),
    };
  }
}

@start src/support/format.ts
export const formatAmount = (amount: number | null) => {
  if (amount === null || amount === undefined) {
    return '';
  }

  return `\u00a3${(amount / 100).toFixed(2)}`;
};

export const formatMoney = (amount: number) => `\u00a3${(amount / 100).toFixed(2)}`;

