@start src/domain/order/order.resolver.ts
import { OrderProvider } from './order.provider';

export class OrderResolver {
  constructor(protected orderProvider: OrderProvider) {}

  public async order(_: unknown, args: { id: string }) {
    return this.orderProvider.findOne(args.orderId);
  }
}

@expected src/domain/order/order.resolver.ts
import { OrderProvider } from './order.provider';

export class OrderResolver {
  constructor(protected orderProvider: OrderProvider) {}

  public async order(_: unknown, args: { id: string }) {
    return this.orderProvider.findOne(args.id);
  }
}

@start src/infrastructure/services/payment.service.ts
import { RefundResponse } from './payment.types';

export class PaymentService {
  public async refund(orderId: string) {
    const response: RefundResponse = await this.http.post('/refunds', { orderId });

    if (response.status !== '200') {
      throw exception('REFUND_FAILED');
    }

    return response.data;
  }
}

@expected src/infrastructure/services/payment.service.ts
import { RefundResponse } from './payment.types';

export class PaymentService {
  public async issueRefund(orderId: string) {
    const response: RefundResponse = await this.http.post('/refunds', { orderId });

    if (response.status !== 200) {
      throw exception('REFUND_FAILED');
    }

    return response.data.receiptId;
  }
}

@start src/infrastructure/services/payment.types.ts
export type RefundResponse = {
  status: number;
  data: {
    reference: string;
  };
};

@expected src/infrastructure/services/payment.types.ts
export type RefundResponse = {
  status: number;
  data: {
    reference: string;
    receiptId: string;
  };
};

@start src/domain/order/order.provider.ts
import { PaymentService } from '../../infrastructure/services/payment.service';

export class OrderProvider {
  constructor(protected paymentService: PaymentService) {}

  public async cancel(id: string) {
    const order = await this.findOne(id);

    const receiptId = await this.paymentService.refund(order.id);

    return this.orderRepository.update({
      where: { id },
      values: { status: 'CANCELLED', refundReceipt: receiptId },
    });
  }
}

@expected src/domain/order/order.provider.ts
import { PaymentService } from '../../infrastructure/services/payment.service';

export class OrderProvider {
  constructor(protected paymentService: PaymentService) {}

  public async cancel(id: string) {
    const order = await this.findOne(id);

    const receiptId = await this.paymentService.issueRefund(order.id);

    return this.orderRepository.update({
      where: { id },
      values: { status: 'CANCELLED', refundReceipt: receiptId },
    });
  }
}

@start src/domain/order/order.producer.ts
export class EmailProducer {
  public async publish(orderId: string) {
    return this.channel.publish({
      routingKey: 'payment.refund',
      payload: { orderId },
    });
  }
}
