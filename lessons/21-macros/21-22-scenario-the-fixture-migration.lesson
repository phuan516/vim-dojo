@start order-status.ts
export enum OrderStatus {
  PENDING,
  CONFIRMED,
  PAID,
  PACKED,
  SHIPPED,
  DELIVERED,
  CANCELLED,
  REFUNDED,
}

@expected order-status.ts
export enum OrderStatus {
  PENDING = 'PENDING',
  CONFIRMED = 'CONFIRMED',
  PAID = 'PAID',
  PACKED = 'PACKED',
  SHIPPED = 'SHIPPED',
  DELIVERED = 'DELIVERED',
  CANCELLED = 'CANCELLED',
  REFUNDED = 'REFUNDED',
}

@start seed.spec.ts
import { seed } from './seed';

describe('seed', () => {
  it('inserts every order', () => {
    const inserted = seed.orders();
    expect(inserted).toHaveLength(14);
  });

  it('inserts every customer', () => {
    const inserted = seed.customers();
    expect(inserted).toHaveLength(8);
  });

  it('is idempotent', () => {
    const second = seed.all();
    expect(second.skipped).toBe(22);
  });
});

@expected seed.spec.ts
import { seed } from './seed';

describe('seed', () => {
  it('inserts every order', async () => {
    const inserted = await seed.orders();
    expect(inserted).toHaveLength(14);
  });

  it('inserts every customer', async () => {
    const inserted = await seed.customers();
    expect(inserted).toHaveLength(8);
  });

  it('is idempotent', async () => {
    const second = await seed.all();
    expect(second.skipped).toBe(22);
  });
});

@start seed.ts
import { orders } from './orders.fixture';
import { customers } from './customers.fixture';
import { OrderStatus } from './order-status';

export const seed = {
  orders: () => orders.map((order) => ({ ...order, status: OrderStatus.PENDING })),
  customers: () => customers,
  all: () => ({ skipped: orders.length + customers.length }),
};
