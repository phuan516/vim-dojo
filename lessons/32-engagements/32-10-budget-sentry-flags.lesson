@start src/configuration/errors/index.ts
import codes from './default.json';

type ErrorCode = keyof typeof codes;

export const exception = (code: ErrorCode) => {
  const definition = codes[code];

  return Object.assign(new Error(code), {
    code,
    statusCode: definition.statusCode,
    sentry: definition.sentry,
  });
};
