@start order.entity.ts
export type Order = {
  id: string;
  customerId: string;
  status: OrderStatus;
  total: number;
  placedAt: Date;
  cancellationReason?: string;
};

export type OrderStatus = 'PENDING' | 'SHIPPED' | 'CANCELLED';
