@start src/domain/order/order.entity.ts
export type Order = {
  id: string;
  customerId: string;
  reference: string;
  status: OrderStatus;
  total: number;
};

export type OrderStatus = 'PENDING' | 'SHIPPED' | 'CANCELLED';
