pending  ORD-1182  CUS-4410  4800
pending  ORD-1183  CUS-4410  1250
pending  ORD-1184  CUS-4411  9900
pending  ORD-1185  CUS-4412  3400
pending  ORD-1186  CUS-4412   750
pending  ORD-1187  CUS-4413  6100
pending  ORD-1188  CUS-4414  2050
pending  ORD-1189  CUS-4415  4800
pending  ORD-1190  CUS-4415  1199
pending  ORD-1191  CUS-4416  8250

