@start src/domain/payment/payment.provider.ts
import { injectable, inject } from 'tsyringe';
import { exception } from '../../configuration/errors';
import { PaymentRepository } from './payment.repository';
import { PaymentProducer } from './payment.producer';
import { PaymentService } from '../../infrastructure/services/payment.service';

@injectable()
export class PaymentProvider {
  constructor(
    @inject(PaymentRepository) protected paymentRepository: PaymentRepository,
    @inject(PaymentProducer) protected paymentProducer: PaymentProducer,
    @inject(PaymentService) protected paymentService: PaymentService,
  ) {}

  public async reverse(id: string) {
    const payment = await this.paymentRepository.findOne({ where: { id } });

    if (!payment) {
      throw exception('PAYMENT_NOT_FOUND');
    }

    const receipt = await this.paymentService.sendRefund(payment.orderId);

    await this.paymentProducer.refundIssued({ paymentId: id, receipt });

    return receipt;
  }

  public async receipt(id: string) {
    const payment = await this.paymentRepository.findOne({ where: { id } });

    if (!payment) {
      throw exception('PAYMENT_NOT_FOUND');
    }

    return {
      charged: formatMoney(payment.amount),
      refunded: formatMoney(payment.refundedAmount ?? 0),
    };
  }
}

@expected src/domain/payment/payment.provider.ts
import { formatMoney } from '@shared/money';
import { injectable, inject } from 'tsyringe';
import { exception } from '../../configuration/errors';
import { PaymentRepository } from './payment.repository';
import { PaymentProducer } from './payment.producer';
import { PaymentService } from '../../infrastructure/services/payment.service';

@injectable()
export class PaymentProvider {
  constructor(
    @inject(PaymentRepository) protected paymentRepository: PaymentRepository,
    @inject(PaymentProducer) protected paymentProducer: PaymentProducer,
    @inject(PaymentService) protected paymentService: PaymentService,
  ) {}

  public async reverse(id: string) {
    const payment = await this.paymentRepository.findOne({ where: { id } });

    if (!payment) {
      throw exception('PAYMENT_NOT_FOUND');
    }

    const receipt = await this.paymentService.sendRefund(payment.orderId);

    await this.paymentProducer.refundIssued({ paymentId: id, receipt });

    return receipt;
  }

  public async receipt(id: string) {
    const payment = await this.paymentRepository.findOne({ where: { id } });

    if (!payment) {
      throw exception('PAYMENT_NOT_FOUND');
    }

    return {
      charged: formatMoney(payment.amount),
      refunded: formatMoney(payment.refundedAmount ?? 0),
    };
  }
}

@start src/infrastructure/services/payment.service.ts
import { injectable, inject } from 'tsyringe';
import { exception } from '../../configuration/errors';
import { HttpClient } from '../http/http.client';

@injectable()
export class PaymentService {
  constructor(@inject(HttpClient) protected http: HttpClient) {}

  public async sendRefund(orderId: string) {
    const response = await this.http.post('/sendRefund', { orderId });

    if (response.status !== 200) {
      throw exception('REFUND_FAILED');
    }

    return response.data;
  }
}
