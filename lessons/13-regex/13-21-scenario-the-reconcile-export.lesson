@start export.provider.ts
import { injectable, inject } from 'tsyringe';
import { OrderRepository } from '../order/order.repository';
import { DEFAULT_CCY } from './export.constants';

const header = 'order_id,customer_id,ccy,amount,status';

@injectable()
export class ExportProvider {
  constructor(@inject(OrderRepository) protected orderRepository: OrderRepository) {}

  public async reconcile(args: { from: Date; to: Date }) {
    const orders = await this.orderRepository.findMany({
      where: { placedAt: { gte: args.from, lt: args.to } },
    });

    return [header, ...orders.map((order) => this.row(order))].join('\n');
  }

  public row(order: { id: string; customerId: string; ccy?: string; total: number; status: string }) {
    const ccyCode = order.ccy ?? DEFAULT_CCY;

    return [order.id, order.customerId, ccyCode, order.total, order.status].join(',');
  }
}

@expected export.provider.ts
import { injectable, inject } from 'tsyringe';
import { OrderRepository } from '../order/order.repository';
import { DEFAULT_CCY } from './export.constants';

const header = 'order_id,customer_id,currency,amount,status';

@injectable()
export class ExportProvider {
  constructor(@inject(OrderRepository) protected orderRepository: OrderRepository) {}

  public async reconcile(args: { from: Date; to: Date }) {
    const orders = await this.orderRepository.findMany({
      where: { placedAt: { gte: args.from, lt: args.to } },
    });

    return [header, ...orders.map((order) => this.row(order))].join('\n');
  }

  public row(order: { id: string; customerId: string; currency?: string; total: number; status: string }) {
    const ccyCode = order.currency ?? DEFAULT_CCY;

    return [order.id, order.customerId, ccyCode, order.total, order.status].join(',');
  }
}

@start README.md
# Reconciliation export

Produced nightly by `ExportProvider.reconcile` and collected by finance
over SFTP at 02:00.

## Columns

| column      | notes                                        |
|-------------|----------------------------------------------|
| order_id    | `ord_` followed by digits                    |
| customer_id | `cus_` followed by digits                    |
| currency    | ISO 4217, upper case: `GBP`, `EUR`           |
| amount      | minor units; negative for a refund           |
| status      | `PAID`, `PENDING` or `REFUNDED`              |

A negative amount must carry the status `REFUNDED`. The importer
rejects the whole file on the first row that breaks this.
