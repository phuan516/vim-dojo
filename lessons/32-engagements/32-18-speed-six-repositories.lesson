import { injectable } from 'tsyringe';
import { Product as ProductRecord } from '@prisma/client';
import { BaseRepository } from '../../infrastructure/base.repository';
import { Product } from './product.entity';

@injectable()
export class ProductRepository extends BaseRepository<ProductRecord, Product> {
  public async findBySku(sku: string) {
    const record = await this.prisma.product.findFirst({
      where: { sku },
    });

    return record ? this.toEntity(record) : null;
  }

  public async findInStock() {
    const records = await this.prisma.product.findMany({
      where: { discontinued: false },
    });

    return records.map((record) => this.toEntity(record));
  }
}

