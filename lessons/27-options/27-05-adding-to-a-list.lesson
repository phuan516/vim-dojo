# Carry-over

- ORD-418 shorten the refund window to 14 days
- ORD-422 gateway schema cache not cleared on deploy

@start src/domain/refund/refund.provider.ts
import { injectable } from 'tsyringe';

@injectable()
export class RefundProvider {
  public readonly windowDays = 30;

  public isInsideWindow(days: number) {
    return days <= this.windowDays;
  }
}

@expected src/domain/refund/refund.provider.ts
import { injectable } from 'tsyringe';

@injectable()
export class RefundProvider {
  public readonly windowDays = 14;

  public isInsideWindow(days: number) {
    return days <= this.windowDays;
  }
}
