});

export const reconciliation = defineConfig({
  schedule: {
    cron: '0 5 * * *',
    timezone: 'Europe/London',
  },
  window: {
    days: 7,
    includeUnsettled: true,
  },
  report: {
    name: 'settlement-reconciliation',
    format: 'csv',
    recipients: [
      'finance@acme.dev',
      'payments@acme.dev',
      'ops@acme.dev',
    ],
    columns: [
      'order',
      'reference',
      'amount',
      'settled',
      'discrepancy',
    ],
    delivery: {
      transport: 'email',
      retries: {
        attempts: 2,
        backoff: {
          strategy: 'fixed',
          initialMs: 60000,
          maxMs: 60000,
        },
      },
    },
  },
  alerts: {
    onDiscrepancy: {
      channel: '#payments-alerts',
      mention: ['@payments-oncall'],
      threshold: {
        count: 1,
        amountMinorUnits: 1000,
      },
    },
    onFailure: {
      channel: '#payments-alerts',
      mention: ['@payments-oncall', '@sre-oncall'],
      threshold: {
        count: 1,
        amountMinorUnits: 0,
      },
    },
  },
});
